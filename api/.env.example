# Tsukuyomi Watch Backend Configuration
PORT=5000
NODE_ENV=development

# Optional NASA API Key (falls back to DEMO_KEY or rich curated offline data)
NASA_API_KEY=DEMO_KEY

# Open-Meteo does not require an API key (Free tier)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Maximum upload file size in bytes (10MB)
MAX_FILE_SIZE_BYTES=10485760
